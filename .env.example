# Database Connection
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/body_metrics_tracker

# Session Configuration
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-super-secret-session-key-here-change-in-production

# Environment
NODE_ENV=development

# Server Port (optional, defaults to 5000)
PORT=5000

# S3 / Object Storage Configuration
# The app reads both AWS_* and Railway-native variable names automatically.
#
# --- Option A: Local development with MinIO ---
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=body-metrics-tracker
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
#
# --- Option B: Railway Object Storage ---
# Link your bucket service and these are injected automatically:
#   ENDPOINT, ACCESS_KEY_ID, SECRET_ACCESS_KEY, REGION, BUCKET
# Or map them explicitly with reference variables:
# S3_ENDPOINT=${{YourBucket.ENDPOINT}}
# S3_BUCKET=${{YourBucket.BUCKET}}
# AWS_ACCESS_KEY_ID=${{YourBucket.ACCESS_KEY_ID}}
# AWS_SECRET_ACCESS_KEY=${{YourBucket.SECRET_ACCESS_KEY}}
# AWS_REGION=${{YourBucket.REGION}}
#
# --- Option C: AWS S3 ---
# S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# AI Image Analysis Providers (for Nutrition feature)
# At least one provider must be configured for food image analysis

# OpenAI API - Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API - Get your API key from: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here