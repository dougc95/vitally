<?xml version="1.0" encoding="UTF-8"?>
<roadmap>
    <feature name="Ingredients and Recipe Suggestions">
        <description>
            A new section within the Nutrition feature that allows users to input ingredients
            (manually or via photo) and receive AI-powered recipe suggestions based on selected
            cuisine/cooking modes.
        </description>
        <route>/nutrition/ingredients</route>
        <target-release>Q2 2026</target-release>

        <!-- ============================================ -->
        <!-- PHASE 1: Core Infrastructure -->
        <!-- ============================================ -->
        <phase id="1" name="Core Infrastructure" priority="high">
            <estimated-duration>1 week</estimated-duration>

            <task id="1.1" status="pending">
                <title>Database Schema Design</title>
                <description>Create tables for storing user ingredients and saved recipes</description>
                <subtasks>
                    <subtask>Create `user_ingredients` table (id, patientId, name, quantity, unit,
                        category, imageUrl, createdAt, expiresAt)</subtask>
                    <subtask>Create `saved_recipes` table (id, patientId, title, description,
                        ingredients, instructions, cuisineType, prepTime, cookTime, servings,
                        macros, imageUrl, createdAt)</subtask>
                    <subtask>Create `recipe_history` table (id, patientId, recipeId, generatedAt,
                        wasCooked, rating)</subtask>
                    <subtask>Add Drizzle schema definitions to shared/schema.ts</subtask>
                    <subtask>Create migration file</subtask>
                </subtasks>
                <files>
                    <file>shared/schema.ts</file>
                    <file>migrations/ingredients_tables.sql</file>
                </files>
            </task>

            <task id="1.2" status="pending">
                <title>API Route Definitions</title>
                <description>Define API routes in shared/routes.ts</description>
                <endpoints>
                    <endpoint method="GET" path="/api/nutrition/ingredients">List user ingredients</endpoint>
                    <endpoint method="POST" path="/api/nutrition/ingredients">Add ingredient(s)</endpoint>
                    <endpoint method="DELETE" path="/api/nutrition/ingredients/:id">Remove
                        ingredient</endpoint>
                    <endpoint method="POST" path="/api/nutrition/ingredients/scan">AI scan
                        ingredients from image</endpoint>
                    <endpoint method="POST" path="/api/nutrition/recipes/suggest">Get AI recipe
                        suggestions</endpoint>
                    <endpoint method="GET" path="/api/nutrition/recipes/saved">List saved recipes</endpoint>
                    <endpoint method="POST" path="/api/nutrition/recipes/save">Save a recipe</endpoint>
                    <endpoint method="DELETE" path="/api/nutrition/recipes/:id">Delete saved recipe</endpoint>
                </endpoints>
                <files>
                    <file>shared/routes.ts</file>
                </files>
            </task>

            <task id="1.3" status="pending">
                <title>Storage Layer Implementation</title>
                <description>Implement CRUD operations in storage.ts</description>
                <files>
                    <file>server/storage.ts</file>
                </files>
            </task>

            <task id="1.4" status="pending">
                <title>Server Route Handlers</title>
                <description>Implement Express route handlers</description>
                <files>
                    <file>server/routes.ts</file>
                </files>
            </task>
        </phase>

        <!-- ============================================ -->
        <!-- PHASE 2: AI Provider Integration -->
        <!-- ============================================ -->
        <phase id="2" name="AI Provider Integration" priority="high">
            <estimated-duration>1 week</estimated-duration>

            <task id="2.1" status="pending">
                <title>Ingredient Scanner Strategy</title>
                <description>Extend AI provider strategy pattern for ingredient scanning</description>
                <subtasks>
                    <subtask>Add `scanIngredients(imageUrl)` method to AIImageAnalyzer interface</subtask>
                    <subtask>Implement in OpenAIProvider</subtask>
                    <subtask>Implement in GeminiProvider</subtask>
                </subtasks>
                <files>
                    <file>server/services/ai-providers/types.ts</file>
                    <file>server/services/ai-providers/openai-provider.ts</file>
                    <file>server/services/ai-providers/gemini-provider.ts</file>
                </files>
            </task>

            <task id="2.2" status="pending">
                <title>Recipe Suggestion Engine</title>
                <description>Create new AI service for recipe generation</description>
                <subtasks>
                    <subtask>Define RecipeSuggestionProvider interface</subtask>
                    <subtask>Create cuisine mode prompts (surprise, asian, mediterranean, mexican,
                        italian, american, indian, healthy, quick)</subtask>
                    <subtask>Implement OpenAI recipe provider</subtask>
                    <subtask>Implement Gemini recipe provider</subtask>
                    <subtask>Include macro estimation in recipe response</subtask>
                </subtasks>
                <files>
                    <file>server/services/ai-providers/types.ts</file>
                    <file>server/services/ai-providers/recipe-prompts.ts</file>
                    <file>server/services/ai-providers/openai-provider.ts</file>
                    <file>server/services/ai-providers/gemini-provider.ts</file>
                </files>
            </task>

            <task id="2.3" status="pending">
                <title>Response Schema Validation</title>
                <description>Define Zod schemas for AI responses</description>
                <response-schemas>
                    <schema name="ScannedIngredient">name, quantity, unit, category, confidence</schema>
                    <schema name="RecipeSuggestion">title, description, ingredients[],
                        instructions[], prepTime, cookTime, servings, difficulty, macros{}</schema>
                </response-schemas>
                <files>
                    <file>shared/schema.ts</file>
                </files>
            </task>
        </phase>

        <!-- ============================================ -->
        <!-- PHASE 3: Client Hooks & State -->
        <!-- ============================================ -->
        <phase id="3" name="Client Hooks & State" priority="high">
            <estimated-duration>3 days</estimated-duration>

            <task id="3.1" status="pending">
                <title>React Query Hooks</title>
                <description>Create hooks for ingredients and recipes</description>
                <hooks>
                    <hook>useIngredients() - List ingredients</hook>
                    <hook>useAddIngredient() - Add single ingredient</hook>
                    <hook>useAddIngredients() - Bulk add ingredients</hook>
                    <hook>useDeleteIngredient() - Remove ingredient</hook>
                    <hook>useScanIngredients() - AI scan from image</hook>
                    <hook>useSuggestRecipes() - Get AI recipe suggestions</hook>
                    <hook>useSavedRecipes() - List saved recipes</hook>
                    <hook>useSaveRecipe() - Save a recipe</hook>
                    <hook>useDeleteRecipe() - Delete saved recipe</hook>
                </hooks>
                <files>
                    <file>client/src/hooks/use-ingredients.ts</file>
                </files>
            </task>

            <task id="3.2" status="pending">
                <title>Type Definitions</title>
                <description>Export TypeScript types from shared schema</description>
                <files>
                    <file>shared/schema.ts</file>
                </files>
            </task>
        </phase>

        <!-- ============================================ -->
        <!-- PHASE 4: UI Components -->
        <!-- ============================================ -->
        <phase id="4" name="UI Components" priority="high">
            <estimated-duration>1.5 weeks</estimated-duration>

            <task id="4.1" status="pending">
                <title>Ingredients List Page</title>
                <description>Main ingredients management view</description>
                <features>
                    <feature>Grid/list view of current ingredients</feature>
                    <feature>Category grouping (produce, protein, dairy, pantry, etc.)</feature>
                    <feature>Quick add button</feature>
                    <feature>Scan photo button</feature>
                    <feature>Swipe to delete</feature>
                    <feature>Expiration indicators</feature>
                </features>
                <files>
                    <file>client/src/pages/Ingredients.tsx</file>
                </files>
            </task>

            <task id="4.2" status="pending">
                <title>Add Ingredient Modal/Sheet</title>
                <description>Manual ingredient entry form</description>
                <fields>
                    <field>Name (autocomplete)</field>
                    <field>Quantity</field>
                    <field>Unit (dropdown)</field>
                    <field>Category (dropdown)</field>
                    <field>Expiration date (optional)</field>
                </fields>
                <files>
                    <file>client/src/components/ingredients/AddIngredientSheet.tsx</file>
                </files>
            </task>

            <task id="4.3" status="pending">
                <title>Ingredient Scanner View</title>
                <description>Photo capture and AI scanning flow</description>
                <flow>
                    <step>Camera/upload interface</step>
                    <step>Loading state with preview</step>
                    <step>Review scanned ingredients (add/remove/edit)</step>
                    <step>Confirm and add to pantry</step>
                </flow>
                <files>
                    <file>client/src/pages/ScanIngredients.tsx</file>
                </files>
            </task>

            <task id="4.4" status="pending">
                <title>Recipe Suggestions Page</title>
                <description>AI recipe generation interface</description>
                <features>
                    <feature>Cuisine mode selector (pill buttons)</feature>
                    <feature>Additional preferences (quick, healthy, comfort, etc.)</feature>
                    <feature>Dietary restrictions toggle</feature>
                    <feature>Generate button</feature>
                    <feature>Recipe cards with preview</feature>
                    <feature>Save to favorites</feature>
                </features>
                <files>
                    <file>client/src/pages/RecipeSuggestions.tsx</file>
                </files>
            </task>

            <task id="4.5" status="pending">
                <title>Recipe Detail View</title>
                <description>Full recipe display</description>
                <sections>
                    <section>Hero image (AI generated or placeholder)</section>
                    <section>Title and description</section>
                    <section>Macro summary card</section>
                    <section>Prep/cook time badges</section>
                    <section>Ingredients checklist</section>
                    <section>Step-by-step instructions</section>
                    <section>Save/share actions</section>
                    <section>"I cooked this" button (logs meal)</section>
                </sections>
                <files>
                    <file>client/src/pages/RecipeDetail.tsx</file>
                </files>
            </task>

            <task id="4.6" status="pending">
                <title>Ingredient Card Component</title>
                <description>Reusable ingredient display card</description>
                <files>
                    <file>client/src/components/ingredients/IngredientCard.tsx</file>
                </files>
            </task>

            <task id="4.7" status="pending">
                <title>Recipe Card Component</title>
                <description>Reusable recipe preview card</description>
                <files>
                    <file>client/src/components/ingredients/RecipeCard.tsx</file>
                </files>
            </task>

            <task id="4.8" status="pending">
                <title>Cuisine Mode Selector</title>
                <description>Horizontal scrollable pill selector</description>
                <modes>
                    <mode icon="sparkles">Surprise Me</mode>
                    <mode icon="utensils">Asian</mode>
                    <mode icon="sun">Mediterranean</mode>
                    <mode icon="flame">Mexican</mode>
                    <mode icon="pizza">Italian</mode>
                    <mode icon="beef">American</mode>
                    <mode icon="leaf">Indian</mode>
                    <mode icon="heart">Healthy</mode>
                    <mode icon="clock">Quick (under 30min)</mode>
                </modes>
                <files>
                    <file>client/src/components/ingredients/CuisineModeSelector.tsx</file>
                </files>
            </task>
        </phase>

        <!-- ============================================ -->
        <!-- PHASE 5: Navigation & Integration -->
        <!-- ============================================ -->
        <phase id="5" name="Navigation & Integration" priority="medium">
            <estimated-duration>2 days</estimated-duration>

            <task id="5.1" status="pending">
                <title>Update Nutrition Dashboard</title>
                <description>Add ingredients section/card to main nutrition page</description>
                <subtasks>
                    <subtask>Add "My Pantry" card showing ingredient count</subtask>
                    <subtask>Add "Get Recipe Ideas" CTA button</subtask>
                    <subtask>Quick access to recent/saved recipes</subtask>
                </subtasks>
                <files>
                    <file>client/src/pages/Nutrition.tsx</file>
                </files>
            </task>

            <task id="5.2" status="pending">
                <title>Route Configuration</title>
                <description>Add new routes to the application</description>
                <routes>
                    <route path="/nutrition/ingredients" component="Ingredients" />
                    <route path="/nutrition/ingredients/scan" component="ScanIngredients" />
                    <route path="/nutrition/recipes" component="RecipeSuggestions" />
                    <route path="/nutrition/recipes/:id" component="RecipeDetail" />
                    <route path="/nutrition/recipes/saved" component="SavedRecipes" />
                </routes>
                <files>
                    <file>client/src/App.tsx</file>
                </files>
            </task>

            <task id="5.3" status="pending">
                <title>Log Cooked Meal Integration</title>
                <description>Allow logging a recipe as a meal with auto-filled macros</description>
                <files>
                    <file>client/src/pages/RecipeDetail.tsx</file>
                    <file>client/src/hooks/use-nutrition.ts</file>
                </files>
            </task>
        </phase>

        <!-- ============================================ -->
        <!-- PHASE 6: Polish & Enhancements -->
        <!-- ============================================ -->
        <phase id="6" name="Polish & Enhancements" priority="low">
            <estimated-duration>1 week</estimated-duration>

            <task id="6.1" status="pending">
                <title>Animations & Transitions</title>
                <description>Add smooth page transitions and micro-interactions</description>
            </task>

            <task id="6.2" status="pending">
                <title>Empty States</title>
                <description>Design empty states for no ingredients, no recipes, etc.</description>
            </task>

            <task id="6.3" status="pending">
                <title>Error Handling</title>
                <description>Graceful error states and retry mechanisms</description>
            </task>

            <task id="6.4" status="pending">
                <title>Loading Skeletons</title>
                <description>Add skeleton loaders for all async content</description>
            </task>

            <task id="6.5" status="pending">
                <title>Offline Support</title>
                <description>Cache ingredients list and saved recipes for offline viewing</description>
            </task>

            <task id="6.6" status="pending">
                <title>Share Recipe</title>
                <description>Generate shareable link or export recipe as image/PDF</description>
            </task>
        </phase>

        <!-- ============================================ -->
        <!-- PHASE 7: Testing -->
        <!-- ============================================ -->
        <phase id="7" name="Testing" priority="medium">
            <estimated-duration>3 days</estimated-duration>

            <task id="7.1" status="pending">
                <title>Unit Tests</title>
                <description>Test storage methods and AI provider functions</description>
                <files>
                    <file>server/services/ai-providers/*.test.ts</file>
                    <file>server/storage.test.ts</file>
                </files>
            </task>

            <task id="7.2" status="pending">
                <title>API Integration Tests</title>
                <description>Test all ingredient and recipe endpoints</description>
                <files>
                    <file>server/routes.test.ts</file>
                </files>
            </task>

            <task id="7.3" status="pending">
                <title>E2E Tests</title>
                <description>Full flow testing with Playwright</description>
                <flows>
                    <flow>Add ingredient manually</flow>
                    <flow>Scan ingredients from photo</flow>
                    <flow>Generate recipe suggestions</flow>
                    <flow>Save and view recipe</flow>
                    <flow>Log recipe as meal</flow>
                </flows>
            </task>
        </phase>

        <!-- ============================================ -->
        <!-- CUISINE MODES REFERENCE -->
        <!-- ============================================ -->
        <cuisine-modes>
            <mode id="surprise" label="Surprise Me" prompt="Create a creative and unexpected recipe" />
            <mode id="asian" label="Asian"
                prompt="Create an Asian-inspired recipe (Chinese, Japanese, Korean, Thai, Vietnamese)" />
            <mode id="mediterranean" label="Mediterranean"
                prompt="Create a Mediterranean recipe (Greek, Lebanese, Turkish)" />
            <mode id="mexican" label="Mexican"
                prompt="Create a Mexican or Latin American inspired recipe" />
            <mode id="italian" label="Italian"
                prompt="Create an Italian recipe (pasta, risotto, etc.)" />
            <mode id="american" label="American"
                prompt="Create a classic American comfort food recipe" />
            <mode id="indian" label="Indian"
                prompt="Create an Indian-inspired recipe with aromatic spices" />
            <mode id="healthy" label="Healthy"
                prompt="Create a nutritious, balanced, low-calorie recipe" />
            <mode id="quick" label="Quick"
                prompt="Create a recipe that can be prepared in under 30 minutes" />
            <mode id="keto" label="Keto" prompt="Create a low-carb, high-fat ketogenic recipe" />
            <mode id="vegetarian" label="Vegetarian"
                prompt="Create a vegetarian recipe without meat" />
            <mode id="vegan" label="Vegan"
                prompt="Create a vegan recipe without any animal products" />
        </cuisine-modes>

        <!-- ============================================ -->
        <!-- DEPENDENCIES -->
        <!-- ============================================ -->
        <dependencies>
            <dependency>Existing AI provider strategy pattern (OpenAI, Gemini)</dependency>
            <dependency>React Query for state management</dependency>
            <dependency>Tailwind CSS for styling</dependency>
            <dependency>Lucide icons</dependency>
            <dependency>shadcn/ui components</dependency>
        </dependencies>

        <!-- ============================================ -->
        <!-- SUCCESS METRICS -->
        <!-- ============================================ -->
        <success-metrics>
            <metric>User can add ingredients manually in under 10 seconds</metric>
            <metric>Photo scanning identifies 80%+ of visible ingredients</metric>
            <metric>Recipe suggestions generated in under 5 seconds</metric>
            <metric>Users save at least 1 recipe per week on average</metric>
            <metric>50% of generated recipes get "I cooked this" logged</metric>
        </success-metrics>
    </feature>
</roadmap>