      priority="medium"
      complexity="simple"
      estimated_minutes="10">
      <files>
        <file path="package.json" action="modify" />
      </files>
      <changes>
        <change>Replace db:push with db:generate, db:migrate, db:studio</change>
      </changes>
      <dependencies />
      <verification>New scripts available: npm run db:generate, db:migrate, db:studio</verification>
    </task>
