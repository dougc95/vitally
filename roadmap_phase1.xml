      <commands>
        <command>npm install bcrypt</command>
        <command>npm install --save-dev @types/bcrypt</command>
      </commands>
      <dependencies />
      <verification>Check package.json includes bcrypt and @types/bcrypt</verification>
    </task>

    <task
      id="1.2"
      description="Add password field to users schema"
      priority="high"
      complexity="simple"
      estimated_minutes="15">
