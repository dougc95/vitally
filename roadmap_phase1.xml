        <command>npx drizzle-kit generate:pg --name=baseline_schema</command>
      </commands>
      <dependencies>
        <depends_on task_id="1.2" />
        <depends_on task_id="1.4" />
      </dependencies>
      <verification>
        <check>Migration file created in migrations/ directory</check>
        <check>SQL includes CREATE TABLE for users, sessions, patients, observations, metrics, goals</check>
      </verification>
    </task>

    <task
      id="2.2"
      description="Generate password field migration"
      priority="high"
      complexity="medium"
      estimated_minutes="20">
      <files>
        <file path="migrations/0001_add_user_password.sql" action="create" />
      </files>
      <commands>
        <command>npx drizzle-kit generate:pg --name=add_user_password</command>
      </commands>
