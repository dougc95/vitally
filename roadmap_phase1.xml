  <!-- Risk Assessment -->
  <risks>
    <risk severity="high" mitigation="Test session creation immediately after setupAuth">
      Session store misconfiguration
    </risk>
    <risk severity="high"
      mitigation="Migration uses nullable password temporarily, require password reset">
      Existing users with no passwords
    </risk>
    <risk severity="high"
      mitigation="Update all references to use req.user.id instead of req.user.claims.sub">
      Breaking req.user structure changes
    </risk>
    <risk severity="medium" mitigation="Thorough multi-user testing before deployment">
      Ownership checks too strict causing false rejections
    </risk>
    <risk severity="medium" mitigation="Generate baseline migration first, then password field">
      Migration order issues
    </risk>
  </risks>

