<?xml version="1.0" encoding="UTF-8"?>
<roadmap_phase2>
    <metadata>
        <phase>Phase 2: Data Portability</phase>
        <status>pending</status>
        <estimated_hours>20-28</estimated_hours>
        <created>2026-01-04</created>
        <description>
            Enable data import/export capabilities with CSV/Excel import featuring
            validation and preview, plus FHIR R4 JSON export endpoints for
            interoperability with healthcare systems.
        </description>
    </metadata>

    <!-- STAGE 1: Dependencies and Infrastructure -->
    <stage id="1" name="Dependencies and Infrastructure" status="completed">
        <task
            id="1.0"
            description="Setup S3/MinIO Infrastructure"
            priority="critical"
            complexity="medium"
            estimated_minutes="45"
            status="completed">
            <files>
                <file path="docker-compose.yml" action="modify" />
                <file path="server/s3.ts" action="create" />
                <file path=".env.example" action="modify" />
                <file path="package.json" action="modify" />
            </files>
            <changes>
                <change>Add MinIO service to docker-compose</change>
                <change>Install @aws-sdk/client-s3</change>
                <change>Create S3 client configuration with MinIO support</change>
                <change>Add S3 environment variables</change>
                <change>Verify S3 connectivity with script</change>
            </changes>
            <dependencies />
            <verification>
                <check>MinIO container running</check>
                <check>S3 client connects to local MinIO</check>
                <check>Bucket auto-creation works</check>
            </verification>
        </task>
        <task
            id="1.1"
            description="Install CSV/Excel parsing dependencies"
            priority="high"
            complexity="simple"
            estimated_minutes="15"
            status="completed">
            <files>
                <file path="package.json" action="modify" />
                <file path="package-lock.json" action="modify" />
            </files>
            <commands>
                <command>npm install papaparse xlsx</command>
                <command>npm install --save-dev @types/papaparse</command>
            </commands>
            <dependencies />
            <verification>
                <check>package.json includes papaparse and xlsx</check>
                <check>@types/papaparse installed for TypeScript support</check>
            </verification>
            <notes>papaparse for CSV, xlsx (SheetJS) for Excel files</notes>
        </task>

        <task
            id="1.2"
            description="Install file upload middleware"
            priority="high"
            complexity="simple"
            estimated_minutes="10">
            <files>
                <file path="package.json" action="modify" />
            </files>
            <commands>
                <command>npm install multer</command>
                <command>npm install --save-dev @types/multer</command>
            </commands>
            <dependencies />
            <verification>
                <check>multer package installed</check>
                <check>@types/multer installed for TypeScript support</check>
            </verification>
        </task>

        <task
            id="1.3"
            description="Create shared import/export type definitions"
            priority="high"
            complexity="medium"
            estimated_minutes="30">
            <files>
                <file path="shared/types/import-export.ts" action="create" />
            </files>
            <changes>
                <change>Define ImportRow interface (date, metricCode, value, unit?, note?)</change>
                <change>Define ImportValidationError interface (row, field, message)</change>
                <change>Define ImportPreview interface (valid: ImportRow[], errors:
                    ImportValidationError[], summary)</change>
                <change>Define ImportResult interface (imported: number, skipped: number, errors:
                    ImportValidationError[])</change>
                <change>Define supported file formats enum (CSV, XLSX, XLS)</change>
            </changes>
            <dependencies />
            <verification>
                <check>Types exported and usable in both client and server</check>
                <check>Types cover all import workflow states</check>
            </verification>
        </task>

        <task
            id="1.4"
            description="Add import/export Zod schemas to shared/routes.ts"
            priority="high"
            complexity="medium"
            estimated_minutes="25">
            <files>
                <file path="shared/routes.ts" action="modify" />
            </files>
            <changes>
                <change>Add import.preview schema (file validation response)</change>
                <change>Add import.confirm schema (confirmed rows to import)</change>
                <change>Add export.fhir.observations schema (date range, format options)</change>
                <change>Add export.fhir.patient schema</change>
                <change>Add export.fhir.goals schema (month range)</change>
            </changes>
            <dependencies>
                <depends_on task_id="1.3" />
            </dependencies>
            <verification>
                <check>Schemas validate import/export request payloads</check>
                <check>Schemas match TypeScript type definitions</check>
            </verification>
        </task>
    </stage>

