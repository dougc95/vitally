            id="2.2"
            description="Create import parser service"
            priority="high"
            complexity="high"
            estimated_minutes="90">
            <files>
                <file path="server/services/import-parser.ts" action="create" />
            </files>
            <changes>
                <change>Create parseCSV(buffer: Buffer): ParsedRow[] using papaparse</change>
                <change>Create parseExcel(buffer: Buffer): ParsedRow[] using xlsx</change>
                <change>Auto-detect file format from buffer magic bytes</change>
                <change>Normalize column headers (case-insensitive, trim whitespace)</change>
                <change>Map common column name variations (e.g., "Weight (kg)" → weight)</change>
                <change>Handle date format variations (YYYY-MM-DD, MM/DD/YYYY, DD/MM/YYYY)</change>
                <change>Return uniform ParsedRow[] regardless of source format</change>
            </changes>
            <dependencies>
                <depends_on task_id="1.1" />
                <depends_on task_id="1.3" />
            </dependencies>
            <verification>
                <check>CSV parsing handles headers and data rows</check>
                <check>Excel parsing reads first sheet by default</check>
                <check>Date parsing handles multiple formats</check>
                <check>Column mapping is case-insensitive</check>
            </verification>
        </task>

        <task
            id="2.3"
            description="Create import validation service"
            priority="high"
            complexity="high"
            estimated_minutes="60">
            <files>
                <file path="server/services/import-validator.ts" action="create" />
            </files>
            <changes>
                <change>Validate date field is present and parseable</change>
                <change>Validate metric codes exist in metrics table</change>
                <change>Validate numeric values are within reasonable ranges</change>
                <change>Validate units match metric's expected unit (or convert)</change>
                <change>Flag duplicate entries (same date + metric)</change>
                <change>Return ImportPreview with valid rows and errors</change>
            </changes>
            <dependencies>
                <depends_on task_id="2.2" />
            </dependencies>
            <verification>
                <check>Invalid dates flagged with row number and message</check>
                <check>Unknown metric codes flagged</check>
                <check>Value range checks (e.g., weight 20-500kg)</check>
                <check>Duplicate detection works correctly</check>
            </verification>
        </task>

        <task
            id="2.4"
            description="Create import processing service"
            priority="high"
            complexity="high"
            estimated_minutes="60">
            <files>
                <file path="server/services/import-processor.ts" action="create" />
            </files>
            <changes>
                <change>Accept validated ImportRow[] and patientId</change>
                <change>Group rows by date for batch observation creation</change>
                <change>Use database transaction for atomicity</change>
                <change>Handle merge strategy: skip duplicates vs overwrite</change>
                <change>Return ImportResult with counts and any runtime errors</change>
            </changes>
            <dependencies>
                <depends_on task_id="2.3" />
            </dependencies>
            <verification>
                <check>Transaction rolls back on error</check>
                <check>Multiple metrics on same date create single observation</check>
                <check>Duplicate handling works per strategy</check>
                <check>Returns accurate import counts</check>
            </verification>
        </task>

        <task
            id="2.5"
            description="Add import API endpoints to routes.ts"
            priority="high"
            complexity="medium"
            estimated_minutes="45">
            <files>
                <file path="server/routes.ts" action="modify" />
            </files>
            <changes>
                <change>POST /api/import/preview - upload file, return validation preview</change>
                <change>POST /api/import/confirm - accept validated rows, perform import</change>
                <change>GET /api/import/template - download CSV template with headers</change>
                <change>All endpoints require isAuthenticated</change>
                <change>All endpoints include ownership checks</change>
            </changes>
            <dependencies>
                <depends_on task_id="2.1" />
                <depends_on task_id="2.4" />
            </dependencies>
            <verification>
                <check>Preview endpoint returns validation results without saving</check>
                <check>Confirm endpoint only accepts pre-validated data</check>
                <check>Template download works correctly</check>
                <check>401 returned for unauthenticated requests</check>
            </verification>
        </task>
    </stage>

