                <change>Export configured multer middleware</change>
            </changes>
            <dependencies>
                <depends_on task_id="1.2" />
            </dependencies>
            <verification>
                <check>Middleware rejects files over 5MB</check>
                <check>Middleware rejects non-CSV/Excel files</check>
                <check>File buffer accessible in req.file</check>
